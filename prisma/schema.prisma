generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
  CONCEPT
  ARCHIVED
}

enum OpportunityType {
  FULL_TIME
  PART_TIME
  FREELANCE
  INTERNSHIP
  CONTRACT
  COLLABORATION
  VOLUNTEER
  SCHOLARSHIP
  PROJECT_BASED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ContactRequestType {
  HIRE
  COLLABORATION
}

enum ContactRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String?
  username        String         @unique
  role            Role           @default(USER)
  emailVerifiedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  profile         Profile?
  projects        Project[]
  refreshTokens   RefreshToken[]
  likes           ProjectLike[]
  bookmarks       Bookmark[]
  notifications   Notification[]
  oauthAccounts   OAuthAccount[]
  reports         Report[]
  emailNotifications Boolean @default(true)
  contactRequestsSent ContactRequest[] @relation("ContactRequestSender")
  contactRequestsReceived ContactRequest[] @relation("ContactRequestRecipient")
  conversationsAsUserA Conversation[] @relation("ConversationUserA")
  conversationsAsUserB Conversation[] @relation("ConversationUserB")
  messages Message[]
  passwordResetCodes PasswordResetCode[]
}

model Profile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  professionalTitle  String?
  bio                String?
  avatarUrl          String?
  coverUrl           String?
  location           String?
  country            String?
  availability       String?
  website            String?
  publicEmail        Boolean  @default(false)
  isVerified         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  icon     String?
  projects Project[]
}

model Skill {
  id       String        @id @default(uuid())
  name     String        @unique
  slug     String        @unique
  projects ProjectSkill[]
}

model Project {
  id                  String         @id @default(uuid())
  slug                String         @unique
  title               String
  shortDescription    String
  detailedDescription String?
  creatorId           String
  creator             User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  categoryId          String?
  category            Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  visibility          Visibility     @default(PUBLIC)
  status              ProjectStatus  @default(COMPLETED)
  projectType         String         @default("Personal")
  location            String?
  coverUrl            String?
  viewCount           Int            @default(0)
  deletedAt           DateTime?
  publishedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  skills              ProjectSkill[]
  likes               ProjectLike[]
  bookmarks           Bookmark[]
  reports             Report[]

  @@index([visibility, publishedAt])
  @@index([categoryId])
  @@index([creatorId, visibility])
}

model ProjectSkill {
  projectId String
  skillId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

model ProjectLike {
  id        String  @id @default(uuid())
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Bookmark {
  id        String  @id @default(uuid())
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Opportunity {
  id          String          @id @default(uuid())
  title       String
  company     String
  description String
  type        OpportunityType
  location    String?
  remote      Boolean         @default(false)
  compensation String?
  deadline    DateTime?
  publishedAt DateTime        @default(now())

  @@index([type, publishedAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  href      String?
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model ContactRequest {
  id          String               @id @default(uuid())
  senderId    String
  sender      User                 @relation("ContactRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User                 @relation("ContactRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type        ContactRequestType
  status      ContactRequestStatus @default(PENDING)
  subject     String
  message     String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([recipientId, status, createdAt])
  @@index([senderId, status, createdAt])
}

model Conversation {
  id          String    @id @default(uuid())
  userAId     String
  userA       User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId     String
  userB       User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastMessageAt DateTime?
  messages    Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, readAt])
}

model PasswordResetCode {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String    @unique
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  adminNote  String?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([projectId, status])
  @@index([reporterId, createdAt])
}
